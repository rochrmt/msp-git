<alfresco-config>

   <config evaluator="string-compare" condition="Users" replace="true">
      <users>
         <!-- minimum length for username and password -->
         <username-min-length>2</username-min-length>
         <password-min-length>3</password-min-length>
         <show-authorization-status>false</show-authorization-status>
      </users>
      <!-- This enables/disables the Add External Users Panel on the Add Users page. -->
      <enable-external-users-panel>false</enable-external-users-panel>
   </config>
  <config evaluator="string-compare" condition="DocumentLibrary" >
    <repository-url>${PROTOCOL}://${SERVER_NAME}:${SHARE_PORT}/alfresco</repository-url>
  </config>

   <!-- ================================================================== -->
   <!-- Multi-Signature Workflow forms                                     -->
   <!-- ================================================================== -->

   <!-- Start workflow form: select signatories, due date, priority, ... -->
   <config evaluator="string-compare" condition="activiti$multiSignatureWorkflow">
      <forms>
         <form>
            <field-visibility>
               <show id="bpm:workflowDescription" />
               <show id="bpm:workflowDueDate" />
               <show id="bpm:workflowPriority" />
               <show id="bpm:assignees" />
               <show id="packageItems" />
               <show id="bpm:sendEMailNotifications" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label-id="workflow.set.general" />
               <set id="info" appearance="" template="/org/alfresco/components/form/2-column-set.ftl" />
               <set id="assignee" appearance="title" label="Signataires" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="other" appearance="title" label-id="workflow.set.other" />

               <field id="bpm:workflowDescription" label="Description">
                  <control template="/org/alfresco/components/form/controls/textarea.ftl">
                     <control-param name="style">width: 95%</control-param>
                  </control>
               </field>
               <field id="bpm:workflowDueDate" label="Date d'échéance" set="info">
                  <control template="/org/alfresco/components/form/controls/date.ftl">
                     <control-param name="showTime">false</control-param>
                     <control-param name="submitTime">false</control-param>
                  </control>
               </field>
               <field id="bpm:workflowPriority" label="Priorité" set="info">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:assignees" label="Signataires" set="assignee" />
               <field id="packageItems" set="items" />
               <field id="bpm:sendEMailNotifications" set="other">
                  <control template="/org/alfresco/components/form/controls/workflow/email-notification.ftl" />
               </field>
            </appearance>
         </form>
      </forms>
   </config>

   <!-- Start task form (used when the workflow is launched from a document) -->
   <config evaluator="task-type" condition="sg:submitSignatureTask">
      <forms>
         <form>
            <field-visibility>
               <show id="bpm:workflowDescription" />
               <show id="bpm:workflowDueDate" />
               <show id="bpm:workflowPriority" />
               <show id="bpm:assignees" />
               <show id="packageItems" />
               <show id="bpm:sendEMailNotifications" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Détails de la signature" />
               <set id="info" appearance="" template="/org/alfresco/components/form/2-column-set.ftl" />
               <set id="assignee" appearance="title" label="Signataires" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="other" appearance="title" label-id="workflow.set.other" />

               <field id="bpm:workflowDescription" label="Description">
                  <control template="/org/alfresco/components/form/controls/textarea.ftl">
                     <control-param name="style">width: 95%</control-param>
                  </control>
               </field>
               <field id="bpm:workflowDueDate" label="Date d'échéance" set="info">
                  <control template="/org/alfresco/components/form/controls/date.ftl">
                     <control-param name="showTime">false</control-param>
                     <control-param name="submitTime">false</control-param>
                  </control>
               </field>
               <field id="bpm:workflowPriority" label="Priorité" set="info">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:assignees" label="Signataires" set="assignee" />
               <field id="packageItems" set="items" />
               <field id="bpm:sendEMailNotifications" set="other">
                  <control template="/org/alfresco/components/form/controls/workflow/email-notification.ftl" />
               </field>
            </appearance>
         </form>
      </forms>
   </config>

   <!-- Sign task form: Sign / Reject outcome buttons + comment -->
   <config evaluator="task-type" condition="sg:signTask">
      <forms>
         <form id="workflow-details">
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Document à signer" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="Avancement" />
               <set id="items" appearance="title" label-id="workflow.set.items" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
            </appearance>
         </form>
         <form>
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
               <show id="bpm:comment" />
               <show id="sg:signOutcome" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Document à signer" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="Avancement" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="response" appearance="title" label="Décision" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
               <field id="bpm:comment" label="Commentaire" set="response">
                  <control template="/org/alfresco/components/form/controls/textarea.ftl">
                     <control-param name="saveLineBreaks">true</control-param>
                  </control>
               </field>
               <field id="sg:signOutcome" label="Décision" set="response">
                  <control template="/org/alfresco/components/form/controls/workflow/activiti-transitions.ftl" />
               </field>
            </appearance>
         </form>
      </forms>
   </config>

   <!-- Notification task forms (completed / rejected) -->
   <config evaluator="task-type" condition="sg:signatureCompletedTask">
      <forms>
         <form id="workflow-details">
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
               <show id="sg:signatureStatus" />
               <show id="sg:signatories" />
               <show id="sg:documentHash" />
               <show id="sg:signCount" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Signature terminée" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="État" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="signature-set" appearance="bordered-panel" label="Métadonnées de signature" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
               <field id="sg:signatureStatus" label="Statut" set="signature-set" read-only="true" />
               <field id="sg:signatories" label="Signataires" set="signature-set" read-only="true" />
               <field id="sg:documentHash" label="Empreinte SHA-256" set="signature-set" read-only="true" />
               <field id="sg:signCount" label="Nombre de signatures" set="signature-set" read-only="true" />
            </appearance>
         </form>
         <form>
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
               <show id="sg:signatureStatus" />
               <show id="sg:signatories" />
               <show id="sg:documentHash" />
               <show id="sg:signCount" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Signature terminée" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="État" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="signature-set" appearance="bordered-panel" label="Métadonnées de signature" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
               <field id="sg:signatureStatus" label="Statut" set="signature-set" read-only="true" />
               <field id="sg:signatories" label="Signataires" set="signature-set" read-only="true" />
               <field id="sg:documentHash" label="Empreinte SHA-256" set="signature-set" read-only="true" />
               <field id="sg:signCount" label="Nombre de signatures" set="signature-set" read-only="true" />
            </appearance>
         </form>
      </forms>
   </config>

   <config evaluator="task-type" condition="sg:signatureRejectedTask">
      <forms>
         <form id="workflow-details">
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
               <show id="sg:signatureStatus" />
               <show id="sg:rejectedBy" />
               <show id="sg:rejectionDate" />
               <show id="sg:rejectionComment" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Signature rejetée" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="État" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="signature-set" appearance="bordered-panel" label="Informations de rejet" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
               <field id="sg:signatureStatus" label="Statut" set="signature-set" read-only="true" />
               <field id="sg:rejectedBy" label="Rejeté par" set="signature-set" read-only="true" />
               <field id="sg:rejectionDate" label="Date de rejet" set="signature-set" read-only="true" />
               <field id="sg:rejectionComment" label="Motif du rejet" set="signature-set" read-only="true" />
            </appearance>
         </form>
         <form>
            <field-visibility>
               <show id="message" />
               <show id="taskOwner" />
               <show id="bpm:priority" />
               <show id="bpm:dueDate" />
               <show id="bpm:taskId" />
               <show id="bpm:status" />
               <show id="packageItems" />
               <show id="sg:signatureStatus" />
               <show id="sg:rejectedBy" />
               <show id="sg:rejectionDate" />
               <show id="sg:rejectionComment" />
            </field-visibility>
            <appearance>
               <set id="" appearance="title" label="Signature rejetée" />
               <set id="info" appearance="" template="/org/alfresco/components/form/3-column-set.ftl" />
               <set id="progress" appearance="title" label="État" />
               <set id="items" appearance="title" label-id="workflow.set.items" />
               <set id="signature-set" appearance="bordered-panel" label="Informations de rejet" />

               <field id="message">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="taskOwner" set="info" />
               <field id="bpm:taskId" set="info">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:priority" set="info" read-only="true">
                  <control template="/org/alfresco/components/form/controls/workflow/priority.ftl" />
               </field>
               <field id="bpm:dueDate" set="info" label="Date d'échéance">
                  <control template="/org/alfresco/components/form/controls/info.ftl" />
               </field>
               <field id="bpm:status" set="progress" />
               <field id="packageItems" set="items" />
               <field id="sg:signatureStatus" label="Statut" set="signature-set" read-only="true" />
               <field id="sg:rejectedBy" label="Rejeté par" set="signature-set" read-only="true" />
               <field id="sg:rejectionDate" label="Date de rejet" set="signature-set" read-only="true" />
               <field id="sg:rejectionComment" label="Motif du rejet" set="signature-set" read-only="true" />
            </appearance>
         </form>
      </forms>
   </config>

   <!-- Display signature metadata on document details page -->
   <config evaluator="node-type" condition="cm:content">
      <forms>
         <form>
            <field-visibility>
               <show id="sg:signatureStatus" />
               <show id="sg:signatories" />
               <show id="sg:signatureDate" />
               <show id="sg:documentHash" />
               <show id="sg:signCount" />
               <show id="sg:rejectedBy" />
               <show id="sg:rejectionDate" />
               <show id="sg:rejectionComment" />
            </field-visibility>
            <appearance>
               <set id="signature-set" appearance="bordered-panel" label="Signature" />

               <field id="sg:signatureStatus" label="Statut" set="signature-set" read-only="true" />
               <field id="sg:signatories" label="Signataires" set="signature-set" read-only="true" />
               <field id="sg:signatureDate" label="Date de signature" set="signature-set" read-only="true" />
               <field id="sg:documentHash" label="Empreinte SHA-256" set="signature-set" read-only="true" />
               <field id="sg:signCount" label="Nombre de signatures" set="signature-set" read-only="true" />
               <field id="sg:rejectedBy" label="Rejeté par" set="signature-set" read-only="true" />
               <field id="sg:rejectionDate" label="Date de rejet" set="signature-set" read-only="true" />
               <field id="sg:rejectionComment" label="Motif du rejet" set="signature-set" read-only="true" />
            </appearance>
         </form>
      </forms>
   </config>

</alfresco-config>