# ============================================================
# MSP-GED - Configuration environnement
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs.
#
# --- LOCAL (test) ---
#   SERVER_NAME=localhost
#   PROTOCOL=http
#   SHARE_PORT=80
#
# --- PRODUCTION (VPS avec HTTPS) ---
#   SERVER_NAME=ged-msp.com
#   PROTOCOL=https
#   SHARE_PORT=443
# ============================================================

# Domaine ou nom d'hote
SERVER_NAME=localhost

# Protocole : http en local, https en production
PROTOCOL=http

# Port expose par nginx : 80 en local, 443 en production (HTTPS termine par le proxy externe)
SHARE_PORT=80

# Versions (alignees sur la production)
POSTGRES_TAG=15.6
ALFRESCO_CE_TAG=25.2.0
SHARE_TAG=25.2.0
SEARCH_CE_TAG=2.0.16
TRANSFORM_ENGINE_TAG=5.2.0
ACA_TAG=7.0.0
